# ==========================================
# Multi-Posting Automation Tool - Configuration
# ==========================================

# ------------------------------------------
# 1. CLOUD STORAGE (AWS S3 oder Cloudflare R2)
# Notwendig für Instagram Graph API (Meta lädt Videos via öffentlicher HTTPS-URL)
# ------------------------------------------
STORAGE_PROVIDER=s3 # 's3' oder 'r2'
S3_BUCKET_NAME=my-short-videos-bucket
S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_REGION_NAME=eu-central-1
# Für Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# Bei AWS S3 kann S3_ENDPOINT_URL leer gelassen werden.
S3_ENDPOINT_URL=
# Falls dein Bucket öffentlich ist oder über eine Custom-Domain erreichbar ist (z.B. R2 dev domain: https://pub-xxx.r2.dev)
# Falls leer, wird automatisch eine Pre-Signed URL generiert.
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_EXPIRY=3600

# ------------------------------------------
# 2. YOUTUBE SHORTS (Google Data API v3)
# ------------------------------------------
# Pfad zur OAuth 2.0 Client-Secret-Datei (aus Google Cloud Console heruntergeladen)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
# Pfad zur lokalen Token-Speicherung (wird nach erstem Login automatisch erstellt)
YOUTUBE_TOKEN_FILE=token.json
# 'public', 'unlisted' oder 'private'
YOUTUBE_PRIVACY_STATUS=public
# 22 = People & Blogs
YOUTUBE_CATEGORY_ID=22

# ------------------------------------------
# 3. INSTAGRAM REELS (Meta Graph API)
# Voraussetzung: Instagram Business/Creator Account verknüpft mit Facebook Page
# ------------------------------------------
INSTAGRAM_ACCESS_TOKEN=EAAG...
# Instagram Business Account ID (numerisch, z.B. 17841400000000000)
INSTAGRAM_ACCOUNT_ID=17841400000000000
GRAPH_API_VERSION=v19.0

# ------------------------------------------
# 4. TIKTOK (Playwright Browser-Automation)
# ------------------------------------------
# Verzeichnis, in dem Browser-Cookies und Login-Status gespeichert werden
TIKTOK_SESSION_DIR=./tiktok_session
# Auf 'false' setzen für den ersten manuellen Login oder zum Debuggen, später 'true'
TIKTOK_HEADLESS=false
# Timeout in Millisekunden für Video-Upload und Rendering
TIKTOK_TIMEOUT_MS=120000
